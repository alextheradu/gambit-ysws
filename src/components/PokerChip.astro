---
const { color = '#FFD700', position = [0, 0, 0], scale = 1 } = Astro.props;
---

<div id={`poker-chip-${Math.random().toString(36).substr(2, 9)}`} class="poker-chip" data-color={color} data-position={position.join(',')} data-scale={scale}></div>

<style>
  .poker-chip {
    position: absolute;
    width: 100px;
    height: 100px;
    pointer-events: none;
  }
</style>

<script>
  import * as THREE from 'three';

  class PokerChip {
    constructor(container, color, position, scale) {
      this.container = container;
      this.color = color;
      this.position = position;
      this.scale = scale;
      this.init();
    }

    init() {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 1000);
      const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
      
      renderer.setSize(100, 100);
      this.container.appendChild(renderer.domElement);

      
      const group = new THREE.Group();
      
      
      const geometry = new THREE.CylinderGeometry(1, 1, 0.15, 32);
      const material = new THREE.MeshStandardMaterial({ 
        color: this.color, 
        metalness: 0.8, 
        roughness: 0.2 
      });
      const cylinder = new THREE.Mesh(geometry, material);
      group.add(cylinder);

      
      const innerGeometry = new THREE.CylinderGeometry(0.7, 0.7, 0.16, 32);
      const innerMaterial = new THREE.MeshStandardMaterial({ 
        color: '#ffffff', 
        metalness: 0.9, 
        roughness: 0.1 
      });
      const innerRing = new THREE.Mesh(innerGeometry, innerMaterial);
      group.add(innerRing);

      
      const centerGeometry = new THREE.CylinderGeometry(0.4, 0.4, 0.01, 32);
      const centerMaterial = new THREE.MeshStandardMaterial({ 
        color: this.color, 
        metalness: 0.8, 
        roughness: 0.2 
      });
      const center = new THREE.Mesh(centerGeometry, centerMaterial);
      center.position.y = 0.08;
      group.add(center);

      
      for (let i = 0; i < 12; i++) {
        const angle = (i / 12) * Math.PI * 2;
        const dotGeometry = new THREE.CylinderGeometry(0.05, 0.05, 0.16, 8);
        const dotMaterial = new THREE.MeshStandardMaterial({ 
          color: '#ffffff', 
          metalness: 0.9, 
          roughness: 0.1 
        });
        const dot = new THREE.Mesh(dotGeometry, dotMaterial);
        dot.position.set(
          Math.cos(angle) * 0.85,
          0,
          Math.sin(angle) * 0.85
        );
        dot.rotation.x = Math.PI / 2;
        dot.rotation.z = angle;
        group.add(dot);
      }

      group.scale.set(this.scale, this.scale, this.scale);
      group.position.set(...this.position);
      scene.add(group);

      
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
      scene.add(ambientLight);

      const pointLight = new THREE.PointLight(0xffffff, 1);
      pointLight.position.set(10, 10, 10);
      scene.add(pointLight);

      const pointLight2 = new THREE.PointLight(0xffffff, 0.5);
      pointLight2.position.set(-10, -10, -10);
      scene.add(pointLight2);

      camera.position.z = 5;

      
      const animate = () => {
        requestAnimationFrame(animate);
        group.rotation.y += 0.01;
        group.rotation.x = Math.sin(Date.now() * 0.001) * 0.2;
        renderer.render(scene, camera);
      };

      animate();
    }
  }

  
  document.querySelectorAll('.poker-chip').forEach(chip => {
    const color = chip.dataset.color;
    const position = chip.dataset.position.split(',').map(Number);
    const scale = parseFloat(chip.dataset.scale);
    new PokerChip(chip, color, position, scale);
  });
</script>
