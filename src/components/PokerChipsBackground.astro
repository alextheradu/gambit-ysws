---
---

<canvas id="poker-chips-canvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

<script>
  import * as THREE from 'three';

  
  const CHIP_COLORS = [
    { main: '#FFD700', edge: '#ffffff' }, 
    { main: '#DC2626', edge: '#ffffff' }, 
    { main: '#2563EB', edge: '#ffffff' }, 
    { main: '#16A34A', edge: '#ffffff' }, 
    { main: '#7C3AED', edge: '#ffffff' }, 
    { main: '#F97316', edge: '#ffffff' }, 
  ];

  class PokerChipsScene {
    constructor() {
      this.canvas = document.getElementById('poker-chips-canvas');
      this.scene = new THREE.Scene();
      this.camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
      this.renderer = new THREE.WebGLRenderer({ canvas: this.canvas, alpha: true, antialias: true });
      this.chips = [];
      this.mouseX = 0;
      this.mouseY = 0;
      this.targetMouseX = 0;
      this.targetMouseY = 0;
      this.scrollY = 0;
      this.init();
    }

    init() {
      this.renderer.setSize(window.innerWidth, window.innerHeight);
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
      this.scene.add(ambientLight);

      const pointLight = new THREE.PointLight(0xffffff, 1, 100);
      pointLight.position.set(10, 10, 10);
      this.scene.add(pointLight);

      const pointLight2 = new THREE.PointLight(0xffffff, 0.6, 100);
      pointLight2.position.set(-10, -10, 5);
      this.scene.add(pointLight2);

      
      this.createChips();

      
      this.camera.position.z = 15;

      
      window.addEventListener('resize', () => this.onResize());
      window.addEventListener('mousemove', (e) => this.onMouseMove(e));
      window.addEventListener('scroll', () => this.onScroll());

      
      this.animate();
    }

    createChips() {
      const positions = [
        { x: -8, y: 4, z: -5, scale: 1.8 },
        { x: 9, y: -2, z: -8, scale: 1.5 },
        { x: 7, y: 6, z: -10, scale: 1.3 },
        { x: -6, y: -5, z: -6, scale: 1.6 },
        { x: 2, y: 8, z: -12, scale: 1.2 },
        { x: -9, y: -7, z: -4, scale: 1.4 },
        { x: 5, y: -8, z: -7, scale: 1.5 },
        { x: -3, y: 2, z: -9, scale: 1.3 },
      ];

      positions.forEach((pos, index) => {
        const colorSet = CHIP_COLORS[index % CHIP_COLORS.length];
        const chip = this.createChip(colorSet, pos, index);
        this.chips.push(chip);
        this.scene.add(chip.mesh);
      });
    }

    createChip(colorSet, pos, index) {
      const group = new THREE.Group();

      
      const geometry = new THREE.CylinderGeometry(1, 1, 0.15, 32);
      const material = new THREE.MeshStandardMaterial({
        color: colorSet.main,
        metalness: 0.8,
        roughness: 0.2,
      });
      const cylinder = new THREE.Mesh(geometry, material);
      group.add(cylinder);

      
      const innerGeometry = new THREE.CylinderGeometry(0.7, 0.7, 0.16, 32);
      const innerMaterial = new THREE.MeshStandardMaterial({
        color: colorSet.edge,
        metalness: 0.9,
        roughness: 0.1,
      });
      const innerRing = new THREE.Mesh(innerGeometry, innerMaterial);
      group.add(innerRing);

      
      const centerGeometry = new THREE.CylinderGeometry(0.4, 0.4, 0.02, 32);
      const centerMaterial = new THREE.MeshStandardMaterial({
        color: colorSet.main,
        metalness: 0.8,
        roughness: 0.2,
      });
      const center = new THREE.Mesh(centerGeometry, centerMaterial);
      center.position.y = 0.09;
      group.add(center);

      
      for (let i = 0; i < 12; i++) {
        const angle = (i / 12) * Math.PI * 2;
        const dotGeometry = new THREE.CylinderGeometry(0.06, 0.06, 0.17, 8);
        const dotMaterial = new THREE.MeshStandardMaterial({
          color: colorSet.edge,
          metalness: 0.9,
          roughness: 0.1,
        });
        const dot = new THREE.Mesh(dotGeometry, dotMaterial);
        dot.position.set(
          Math.cos(angle) * 0.85,
          0,
          Math.sin(angle) * 0.85
        );
        dot.rotation.x = Math.PI / 2;
        dot.rotation.z = angle;
        group.add(dot);
      }

      
      group.position.set(pos.x, pos.y, pos.z);
      group.scale.set(pos.scale, pos.scale, pos.scale);

      return {
        mesh: group,
        initialPos: { ...pos },
        rotationSpeed: (Math.random() - 0.5) * 0.02,
        floatSpeed: Math.random() * 0.001 + 0.0005,
        floatOffset: Math.random() * Math.PI * 2,
        parallaxFactor: 0.02 + (pos.z + 12) * 0.005,
        index,
      };
    }

    onResize() {
      this.camera.aspect = window.innerWidth / window.innerHeight;
      this.camera.updateProjectionMatrix();
      this.renderer.setSize(window.innerWidth, window.innerHeight);
    }

    onMouseMove(event) {
      this.targetMouseX = (event.clientX / window.innerWidth) * 2 - 1;
      this.targetMouseY = -(event.clientY / window.innerHeight) * 2 + 1;
    }

    onScroll() {
      this.scrollY = window.scrollY;
    }

    animate() {
      requestAnimationFrame(() => this.animate());

      const time = Date.now() * 0.001;

      
      this.mouseX += (this.targetMouseX - this.mouseX) * 0.05;
      this.mouseY += (this.targetMouseY - this.mouseY) * 0.05;

      
      this.chips.forEach((chip) => {
        const mesh = chip.mesh;

        
        mesh.rotation.y += chip.rotationSpeed;
        mesh.rotation.x = Math.sin(time * chip.floatSpeed + chip.floatOffset) * 0.15;
        mesh.rotation.z = Math.cos(time * chip.floatSpeed * 0.7 + chip.floatOffset) * 0.05;

        
        const floatY = Math.sin(time * chip.floatSpeed + chip.floatOffset) * 0.5;

        
        const parallaxX = this.mouseX * chip.parallaxFactor * 20;
        const parallaxY = this.mouseY * chip.parallaxFactor * 20;

        
        const scrollParallax = this.scrollY * chip.parallaxFactor * 0.5;

        
        mesh.position.x = chip.initialPos.x + parallaxX;
        mesh.position.y = chip.initialPos.y + floatY + parallaxY - scrollParallax;
        mesh.position.z = chip.initialPos.z;
      });

      
      this.camera.position.x = this.mouseX * 0.5;
      this.camera.position.y = this.mouseY * 0.5;
      this.camera.lookAt(0, 0, 0);

      this.renderer.render(this.scene, this.camera);
    }
  }

  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new PokerChipsScene());
  } else {
    new PokerChipsScene();
  }
</script>
