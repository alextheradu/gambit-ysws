---
---

<div class="dice-container absolute right-[8%] top-[15%] w-[160px] h-[200px] z-[50]">
  <canvas id="rolling-dice-canvas" class="w-full h-full pointer-events-auto block"></canvas>
</div>

<script>
  import * as THREE from 'three';

  class RollingDice {
    constructor() {
      this.canvas = document.getElementById('rolling-dice-canvas');
      if (!this.canvas) return;
      
      this.scene = new THREE.Scene();
      this.camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
      this.renderer = new THREE.WebGLRenderer({ canvas: this.canvas, alpha: true, antialias: true });
      this.dice = null;
      this.isRolling = false;
      this.isSettling = false;
      this.settleTarget = { x: 0, y: 0, z: 0 };
      this.rotationVelocity = { x: 0, y: 0, z: 0 };
      this.positionY = 0;
      this.velocityY = 0;
      this.targetRotation = { x: 0, y: 0, z: 0 };
      this.rollStartTime = 0;
      this.lastClickTime = 0;
      
      this.init();
    }

    init() {
      this.renderer.setSize(120, 120);
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
      this.scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xffffff, 1);
      dirLight.position.set(5, 10, 7);
      this.scene.add(dirLight);

      const pointLight = new THREE.PointLight(0xffd700, 0.4, 10);
      pointLight.position.set(-3, 5, 3);
      this.scene.add(pointLight);

      
      this.dice = this.createDice();
      this.scene.add(this.dice);

      
      this.camera.position.z = 6;

      
      this.canvas.addEventListener('click', (e) => this.onClick(e));
      this.canvas.addEventListener('touchstart', (e) => { e.preventDefault(); this.onClick(e.touches[0]); });

      
      this.animate();
    }

    createDice() {
      const group = new THREE.Group();

      
      const geometry = new THREE.BoxGeometry(1.8, 1.8, 1.8);
      const material = new THREE.MeshStandardMaterial({
        color: 0xf5f5f5,
        metalness: 0.1,
        roughness: 0.4,
      });
      const cube = new THREE.Mesh(geometry, material);
      group.add(cube);

      
      
      this.addFaceDots(group, [
        { x: 0, y: 0, z: 0.91, face: 'z+' }
      ], 0.22);

      
      this.addFaceDots(group, [
        { x: -0.5, y: 0.5, z: -0.91, face: 'z-' },
        { x: 0.5, y: -0.5, z: -0.91, face: 'z-' }
      ], 0.18);

      
      this.addFaceDots(group, [
        { x: 0.91, y: 0.5, z: 0.5, face: 'x+' },
        { x: 0.91, y: 0, z: 0, face: 'x+' },
        { x: 0.91, y: -0.5, z: -0.5, face: 'x+' }
      ], 0.18);

      
      this.addFaceDots(group, [
        { x: -0.91, y: 0.5, z: 0.5, face: 'x-' },
        { x: -0.91, y: 0.5, z: -0.5, face: 'x-' },
        { x: -0.91, y: -0.5, z: 0.5, face: 'x-' },
        { x: -0.91, y: -0.5, z: -0.5, face: 'x-' }
      ], 0.16);

      
      this.addFaceDots(group, [
        { x: 0, y: 0.91, z: 0, face: 'y+' },
        { x: -0.5, y: 0.91, z: 0.5, face: 'y+' },
        { x: 0.5, y: 0.91, z: 0.5, face: 'y+' },
        { x: -0.5, y: 0.91, z: -0.5, face: 'y+' },
        { x: 0.5, y: 0.91, z: -0.5, face: 'y+' }
      ], 0.16);

      
      this.addFaceDots(group, [
        { x: -0.5, y: -0.91, z: 0.6, face: 'y-' },
        { x: -0.5, y: -0.91, z: 0, face: 'y-' },
        { x: -0.5, y: -0.91, z: -0.6, face: 'y-' },
        { x: 0.5, y: -0.91, z: 0.6, face: 'y-' },
        { x: 0.5, y: -0.91, z: 0, face: 'y-' },
        { x: 0.5, y: -0.91, z: -0.6, face: 'y-' }
      ], 0.16);

      
      group.rotation.x = 0.4;
      group.rotation.y = 0.6;

      return group;
    }

    addFaceDots(group, positions, size) {
      
      const dotGeometry = new THREE.SphereGeometry(size, 24, 24);
      const dotMaterial = new THREE.MeshStandardMaterial({
        color: 0x1a1a1a,
        metalness: 0.2,
        roughness: 0.5,
      });

      positions.forEach(pos => {
        const dot = new THREE.Mesh(dotGeometry, dotMaterial);
        dot.position.set(pos.x, pos.y, pos.z);
        group.add(dot);
      });
    }

    onClick(e) {
      
      const now = Date.now();
      if (now - this.lastClickTime < 300) return;
      this.lastClickTime = now;
      
      
      if (this.isRolling && now - this.rollStartTime > 3000) {
        this.isRolling = false;
      }
      
      if (this.isRolling) return;
      
      e.preventDefault();
      e.stopPropagation();
      
      this.isRolling = true;
      this.rollStartTime = now;
      
      
      this.velocityY = 0.35;
      
      
      const faces = [
        { x: 0, y: 0, z: 0 },           
        { x: 0, y: Math.PI, z: 0 },       
        { x: 0, y: Math.PI/2, z: 0 },     
        { x: 0, y: -Math.PI/2, z: 0 },    
        { x: -Math.PI/2, y: 0, z: 0 },    
        { x: Math.PI/2, y: 0, z: 0 },     
      ];
      
      const baseFace = faces[Math.floor(Math.random() * faces.length)];
      
      
      const spinsX = (Math.floor(Math.random() * 3) + 2) * Math.PI * 2;
      const spinsY = (Math.floor(Math.random() * 3) + 2) * Math.PI * 2;
      const spinsZ = (Math.floor(Math.random() * 2) + 1) * Math.PI * 2;
      
      this.targetRotation = {
        x: baseFace.x + spinsX * (Math.random() > 0.5 ? 1 : -1),
        y: baseFace.y + spinsY * (Math.random() > 0.5 ? 1 : -1),
        z: baseFace.z + spinsZ * (Math.random() > 0.5 ? 1 : -1),
      };
    }

    animate() {
      requestAnimationFrame(() => this.animate());

      if (this.dice) {
        
        if (this.isRolling && Date.now() - this.rollStartTime > 4000) {
          this.isRolling = false;
          this.velocityY = 0;
          this.positionY = 0;
          this.dice.position.y = 0;
          this.dice.rotation.x = this.targetRotation.x;
          this.dice.rotation.y = this.targetRotation.y;
          this.dice.rotation.z = this.targetRotation.z;
        }
        
        if (this.isRolling) {
          
          this.positionY += this.velocityY;
          this.velocityY -= 0.015; 
          
          
          if (this.positionY <= 0) {
            this.positionY = 0;
            this.velocityY = -this.velocityY * 0.4; 
            
            
            if (Math.abs(this.velocityY) < 0.015) {
              this.isRolling = false;
              this.velocityY = 0;
              this.positionY = 0;
              
              this.dice.rotation.x = this.targetRotation.x;
              this.dice.rotation.y = this.targetRotation.y;
              this.dice.rotation.z = this.targetRotation.z;
            }
          }
          
          
          if (this.positionY <= 0.01 && Math.abs(this.velocityY) < 0.001 && this.isRolling) {
            this.isRolling = false;
            this.velocityY = 0;
            this.positionY = 0;
            this.dice.rotation.x = this.targetRotation.x;
            this.dice.rotation.y = this.targetRotation.y;
            this.dice.rotation.z = this.targetRotation.z;
          }
          
          this.dice.position.y = this.positionY;
          
          
          const distToTarget = Math.abs(this.dice.rotation.x - this.targetRotation.x) + 
                               Math.abs(this.dice.rotation.y - this.targetRotation.y) +
                               Math.abs(this.dice.rotation.z - this.targetRotation.z);
          const lerpFactor = Math.max(0.03, Math.min(0.1, distToTarget * 0.02));
          
          this.dice.rotation.x += (this.targetRotation.x - this.dice.rotation.x) * lerpFactor;
          this.dice.rotation.y += (this.targetRotation.y - this.dice.rotation.y) * lerpFactor;
          this.dice.rotation.z += (this.targetRotation.z - this.dice.rotation.z) * lerpFactor;
        } else {
          
          this.dice.position.y = Math.sin(Date.now() * 0.002) * 0.03;
        }
      }

      this.renderer.render(this.scene, this.camera);
    }

    calculateSettleTarget() {
      
      
      const faces = [
        { x: 0, y: 0, z: 0, name: '1' },                    
        { x: 0, y: Math.PI, z: 0, name: '2' },              
        { x: 0, y: Math.PI/2, z: 0, name: '3' },            
        { x: 0, y: -Math.PI/2, z: 0, name: '4' },           
        { x: -Math.PI/2, y: 0, z: 0, name: '5' },           
        { x: Math.PI/2, y: 0, z: 0, name: '6' },            
      ];
      
      
      const normalizeAngle = (angle) => {
        angle = angle % (Math.PI * 2);
        if (angle < 0) angle += Math.PI * 2;
        return angle;
      };
      
      const currentX = normalizeAngle(this.dice.rotation.x);
      const currentY = normalizeAngle(this.dice.rotation.y);
      const currentZ = normalizeAngle(this.dice.rotation.z);
      
      
      let nearestFace = faces[0];
      let minDistance = Infinity;
      
      for (const face of faces) {
        const targetX = normalizeAngle(face.x);
        const targetY = normalizeAngle(face.y);
        const targetZ = normalizeAngle(face.z);
        
        
        const distX = Math.abs(currentX - targetX);
        const distY = Math.abs(currentY - targetY);
        const distZ = Math.abs(currentZ - targetZ);
        
        
        const angularDistX = Math.min(distX, Math.PI * 2 - distX);
        const angularDistY = Math.min(distY, Math.PI * 2 - distY);
        const angularDistZ = Math.min(distZ, Math.PI * 2 - distZ);
        
        const totalDist = angularDistX + angularDistY + angularDistZ;
        
        if (totalDist < minDistance) {
          minDistance = totalDist;
          nearestFace = face;
        }
      }
      
      
      
      const roundToNearestMultiple = (value, multiple) => {
        return Math.round(value / multiple) * multiple;
      };
      
      
      const nearestX = roundToNearestMultiple(this.dice.rotation.x, Math.PI / 2);
      const nearestY = roundToNearestMultiple(this.dice.rotation.y, Math.PI / 2);
      const nearestZ = roundToNearestMultiple(this.dice.rotation.z, Math.PI / 2);
      
      
      this.settleTarget = {
        x: nearestX + (nearestFace.x - normalizeAngle(nearestX)),
        y: nearestY + (nearestFace.y - normalizeAngle(nearestY)),
        z: nearestZ + (nearestFace.z - normalizeAngle(nearestZ))
      };
      
      this.isSettling = true;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new RollingDice());
  } else {
    new RollingDice();
  }
</script>

<style>
  .dice-container {
    filter: drop-shadow(0 8px 20px rgba(0,0,0,0.4));
    user-select: none;
    -webkit-user-select: none;
  }
  #rolling-dice-canvas {
    cursor: pointer;
    display: block;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }
  #rolling-dice-canvas:hover {
    filter: brightness(1.1);
  }
</style>
