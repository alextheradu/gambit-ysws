---
---

<canvas id="hero-chips-canvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

<script>
  import * as THREE from 'three';

  class FallingChips {
    constructor() {
      this.canvas = document.getElementById('hero-chips-canvas');
      if (!this.canvas) return;
      
      this.scene = new THREE.Scene();
      this.camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
      this.renderer = new THREE.WebGLRenderer({ canvas: this.canvas, alpha: true, antialias: true });
      this.chips = [];
      this.chipCount = 20;
      this.fallSpeed = 0.08;
      
      this.init();
    }

    init() {
      this.renderer.setSize(window.innerWidth, window.innerHeight);
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
      this.scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
      dirLight.position.set(5, 10, 7);
      this.scene.add(dirLight);

      
      this.createChips();

      
      this.camera.position.z = 15;
      this.camera.position.y = 0;

      
      window.addEventListener('resize', () => this.onResize());

      
      this.animate();
    }

    createChips() {
      for (let i = 0; i < this.chipCount; i++) {
        const chip = this.createChip(i);
        this.chips.push(chip);
        this.scene.add(chip.mesh);
      }
    }

    createChip(index) {
      const group = new THREE.Group();

      
      const geometry = new THREE.CylinderGeometry(0.85, 0.85, 0.1, 48);
      const material = new THREE.MeshStandardMaterial({
        color: 0x1a1a1a,
        metalness: 0.9,
        roughness: 0.3,
      });
      const cylinder = new THREE.Mesh(geometry, material);
      group.add(cylinder);

      
      for (let r = 0.82; r > 0.7; r -= 0.03) {
        const stripeGeometry = new THREE.CylinderGeometry(r, r, 0.11, 48);
        const isWhite = Math.floor((0.82 - r) / 0.03) % 2 === 0;
        const stripeMaterial = new THREE.MeshStandardMaterial({
          color: isWhite ? 0xffffff : 0x1a1a1a,
          metalness: 0.95,
          roughness: 0.15,
        });
        const stripe = new THREE.Mesh(stripeGeometry, stripeMaterial);
        group.add(stripe);
      }

      
      const dashCount = 16;
      for (let i = 0; i < dashCount; i++) {
        const angle = (i / dashCount) * Math.PI * 2;
        const dashGeometry = new THREE.BoxGeometry(0.06, 0.02, 0.02);
        const dashMaterial = new THREE.MeshStandardMaterial({
          color: 0xffffff,
          metalness: 0.95,
          roughness: 0.1,
        });
        const dash = new THREE.Mesh(dashGeometry, dashMaterial);
        dash.position.set(
          Math.cos(angle) * 0.76,
          0.06,
          Math.sin(angle) * 0.76
        );
        dash.rotation.y = angle;
        group.add(dash);
      }

      
      const innerRingGeometry = new THREE.CylinderGeometry(0.68, 0.68, 0.12, 48);
      const innerRingMaterial = new THREE.MeshStandardMaterial({
        color: 0xffffff,
        metalness: 0.92,
        roughness: 0.12,
      });
      const innerRing = new THREE.Mesh(innerRingGeometry, innerRingMaterial);
      group.add(innerRing);

      
      const centerBaseGeometry = new THREE.CylinderGeometry(0.6, 0.6, 0.13, 48);
      const centerBaseMaterial = new THREE.MeshStandardMaterial({
        color: 0x1a1a1a,
        metalness: 0.9,
        roughness: 0.25,
      });
      const centerBase = new THREE.Mesh(centerBaseGeometry, centerBaseMaterial);
      group.add(centerBase);

      
      for (let i = 0; i < 4; i++) {
        const angle = (i / 4) * Math.PI * 2;
        const crossGeometry = new THREE.BoxGeometry(0.04, 0.14, 0.35);
        const crossMaterial = new THREE.MeshStandardMaterial({
          color: 0xffffff,
          metalness: 0.95,
          roughness: 0.1,
        });
        const cross = new THREE.Mesh(crossGeometry, crossMaterial);
        cross.position.set(
          Math.cos(angle) * 0.15,
          0.07,
          Math.sin(angle) * 0.15
        );
        cross.rotation.y = angle;
        group.add(cross);
      }

      
      const centerDotGeometry = new THREE.CylinderGeometry(0.15, 0.15, 0.15, 32);
      const centerDotMaterial = new THREE.MeshStandardMaterial({
        color: 0xffffff,
        metalness: 0.98,
        roughness: 0.05,
      });
      const centerDot = new THREE.Mesh(centerDotGeometry, centerDotMaterial);
      centerDot.position.y = 0.075;
      group.add(centerDot);

      
      for (let i = 0; i < 8; i++) {
        const angle = (i / 8) * Math.PI * 2;
        const dotGeometry = new THREE.CylinderGeometry(0.04, 0.04, 0.14, 16);
        const dotMaterial = new THREE.MeshStandardMaterial({
          color: i % 2 === 0 ? 0xffffff : 0x1a1a1a,
          metalness: 0.9,
          roughness: 0.15,
        });
        const dot = new THREE.Mesh(dotGeometry, dotMaterial);
        dot.position.set(
          Math.cos(angle) * 0.45,
          0.07,
          Math.sin(angle) * 0.45
        );
        group.add(dot);
      }

      
      const x = (Math.random() - 0.5) * 25;
      const y = 12 + Math.random() * 15;
      const z = (Math.random() - 0.5) * 10 - 5;

      group.position.set(x, y, z);
      
      
      group.rotation.x = Math.random() * Math.PI;
      group.rotation.y = Math.random() * Math.PI;
      group.rotation.z = Math.random() * Math.PI;

      return {
        mesh: group,
        rotationSpeed: {
          x: (Math.random() - 0.5) * 0.03,
          y: (Math.random() - 0.5) * 0.03,
          z: (Math.random() - 0.5) * 0.02,
        },
        fallSpeed: this.fallSpeed + Math.random() * 0.05,
        wobbleSpeed: Math.random() * 0.002,
        wobbleOffset: Math.random() * Math.PI * 2,
      };
    }

    onResize() {
      this.camera.aspect = window.innerWidth / window.innerHeight;
      this.camera.updateProjectionMatrix();
      this.renderer.setSize(window.innerWidth, window.innerHeight);
    }

    resetChip(chip) {
      
      chip.mesh.position.y = 12 + Math.random() * 5;
      chip.mesh.position.x = (Math.random() - 0.5) * 25;
      chip.mesh.position.z = (Math.random() - 0.5) * 10 - 5;
      
      
      chip.mesh.rotation.x = Math.random() * Math.PI;
      chip.mesh.rotation.y = Math.random() * Math.PI;
      chip.mesh.rotation.z = Math.random() * Math.PI;
    }

    animate() {
      requestAnimationFrame(() => this.animate());

      const time = Date.now();

      this.chips.forEach((chip) => {
        
        chip.mesh.position.y -= chip.fallSpeed;

        
        chip.mesh.position.x += Math.sin(time * chip.wobbleSpeed + chip.wobbleOffset) * 0.02;

        
        chip.mesh.rotation.x += chip.rotationSpeed.x;
        chip.mesh.rotation.y += chip.rotationSpeed.y;
        chip.mesh.rotation.z += chip.rotationSpeed.z;

        
        if (chip.mesh.position.y < -12) {
          this.resetChip(chip);
        }
      });

      this.renderer.render(this.scene, this.camera);
    }
  }

  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new FallingChips());
  } else {
    new FallingChips();
  }
</script>
